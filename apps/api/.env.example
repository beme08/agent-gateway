SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
AGENT_API_KEY=local-dev-shared-secret
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
COHERE_EMBED_MODEL=embed-english-v3.0
ENABLE_PUBLIC_UPLOAD=false
LOG_LEVEL=info

# --- LLM provider selection (optional) --------------------------------------
# Explicit provider: oxalpha | openai_compat | cohere. Empty = legacy
# auto-detect (openai_compat when configured, else Cohere). The orchestrator
# builds a failover chain, so an expired trial degrades to the next provider.
LLM_PROVIDER=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OXALPHA_MODEL=stealth/ox-alpha

# Per-agent override lives in DB: agents.provider / agents.model (migration 0009)
